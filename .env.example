# Copy to .env and adjust. Defaults match docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=pipeline
DB_PASSWORD=pipeline_pass
DB_NAME=contact_centre

# Where each month's source extracts land (one sub-folder per month, e.g. data/raw/2026-10/)
RAW_DIR=./data/raw

# Where the Power BI model workbook is written. The included .pbix reads it from here (see ModelFile).
# Optional, for Power BI web on a Mac: point it at a OneDrive folder so the service can reach it, e.g.:
# EXPORT_DIR=~/Library/CloudStorage/OneDrive-YourOrg/Contact_Centre/powerbi
EXPORT_DIR=./output/powerbi

# Monthly KPI pack (formatted Excel).
REPORT_DIR=./output/reports

# Fail the run if any source rejects more than this share of its rows
MAX_REJECT_RATE=0.02

# Optional: what the Refresh Console's "Open Power BI to refresh" button opens, e.g. your report in Power BI web.
# Leave it empty to open the repo's .pbix on Windows, or app.powerbi.com anywhere else
POWERBI_URL=
